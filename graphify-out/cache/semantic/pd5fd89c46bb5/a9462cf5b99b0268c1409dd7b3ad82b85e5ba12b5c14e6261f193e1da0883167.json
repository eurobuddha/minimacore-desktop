{"nodes": [{"id": "claude_rule_0_follow_instructions", "label": "RULE 0 \u2014 Explicit Instructions Are Blocking", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User instructions override the agent's plan and judgment; reuse named existing code before reinventing; disagree openly, never disobey quietly. Ignoring an instruction wastes time, tokens, and money."}, {"id": "claude_versioning_guardrail", "label": "Versioning Guardrail \u2014 Every Code Change Ships a Version Bump", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real funds, real chain: every committed state must be distinct, reversible and trackable. One logical change = one version = one commit = one push. Docs/config-only commits need no bump. Never bypass with --no-verify."}, {"id": "claude_pre_commit_hook", "label": "Pre-commit Version-Bump Hook (.githooks/pre-commit)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_pre_commit_hook", "target": "claude_versioning_guardrail", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_versioning_guardrail", "target": "changelog_minimacore_desktop_changelog", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_rule_0_follow_instructions", "target": "changelog_byte_identical_engine_reuse", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}]