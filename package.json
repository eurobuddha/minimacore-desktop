{
  "name": "minimacore-desktop",
  "productName": "minimaCore",
  "version": "0.19.181",
  "description": "Cross-platform (macOS/Windows/Linux) wrapper for the minimaCore node — runs the bundled minima.jar locally, with the native-styled self-custody wallet UI over the node's RPC.",
  "author": "eurobuddha",
  "license": "MIT",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "fetch:parlons": "bash scripts/fetch-parlons-node-jar.sh",
    "fetch:keets": "bash scripts/fetch-keets-sidecar.sh",
    "dist": "electron-builder --mac --arm64",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:mac:signed": "KEETS_REQUIRE_DEPS=1 node --test scripts/keets-test.cjs && APPLE_KEYCHAIN_PROFILE=minimadesk npm run dist:mac && scripts/notarize-dmg.sh && scripts/verify-mac.sh",
    "dist:win": "electron-builder --win",
    "dist:pandamonium": "node scripts/build-flavor.cjs pandamonium",
    "test:flavor": "node --test scripts/flavor-test.cjs",
    "dist:linux": "electron-builder --linux",
    "test:node-log": "node scripts/node-log-test.cjs",
    "test:loginitem": "node --test scripts/loginitem-test.cjs",
    "test:mail": "node --test scripts/mail-test.cjs scripts/mail-address-test.cjs scripts/payverify-test.cjs",
    "test:shell": "node --test scripts/shell-test.cjs",
    "test:i18n": "node --test scripts/i18n-test.cjs scripts/mainsaid-test.cjs",
    "test:wallet": "node --test scripts/wallet-money-test.cjs scripts/wallet-review-test.cjs scripts/history-screen-test.cjs scripts/core-screens-test.cjs scripts/keymode-test.cjs scripts/seedgate-test.cjs",
    "test:apps": "node --test scripts/apps-money.test.cjs scripts/apps-screens.test.cjs scripts/shop-test.cjs scripts/shop-store-test.cjs scripts/keyuses-test.cjs scripts/explorer-test.cjs scripts/entropy-test.cjs scripts/futurecash-test.cjs",
    "test:panels": "node --test scripts/panels-test.cjs",
    "test:keets": "node --test scripts/keets-test.cjs",
    "test:atomix": "bash scripts/atomix-parity-check.sh && node scripts/atomix-unit.js",
    "test:ethwallet": "node scripts/ethwallet-unit.js",
    "test:casino": "bash scripts/casino-parity-check.sh && node scripts/casino-glue-test.js",
    "test:termcomplete": "node scripts/termcomplete-test.js",
    "gate:atomix": "node scripts/atomix-boot-gate.js && node scripts/atomix-s2-gate.js",
    "test:rpc": "node --test scripts/rpc-test.cjs",
    "test:netfetch": "node --test scripts/netfetch-test.cjs",
    "test:updater": "node --test scripts/updater-test.cjs",
    "test:config-keys": "node --test scripts/config-keys-test.cjs",
    "test:resync-host": "node --test scripts/resync-host-test.cjs",
    "test:parlons": "node --test scripts/parlons-view-test.cjs scripts/parlons-notify-test.cjs",
    "test:pandapools-recovery": "node --test scripts/pandapools-recovery.test.cjs scripts/pandapools-recovery-lifecycle.test.cjs",
    "test:pandapools-parity": "node scripts/pandapools-parity-check.cjs",
    "test:pandapools-manifest": "node scripts/pandapools-parity-manifest.cjs --verify",
    "test:pandapools": "npm run test:pandapools-manifest && node --test scripts/pandapools-recovery.test.cjs scripts/pandapools-recovery-lifecycle.test.cjs scripts/pandapools-signgate.test.cjs scripts/pandapools-consolidation.test.cjs",
    "test:chat": "node --test scripts/chat-test.cjs scripts/chatfiles-test.cjs",
    "test:dexicon-parity": "node scripts/dexicon-parity-check.cjs",
    "test:dexicon-manifest": "node scripts/dexicon-parity-manifest.cjs --verify",
    "test:dexicon-page": "node scripts/dexicon-page-manifest.cjs --verify",
    "test:dexicon": "npm run test:dexicon-manifest && npm run test:dexicon-page && node --test scripts/dexicon-host.test.cjs scripts/dexicon-ui.test.cjs scripts/dexicon-ax.test.cjs scripts/dexicon-pp.test.cjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.eurobuddha.minimacore",
    "productName": "minimaCore",
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "identity": "Developer ID Application",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Minima Core uses your camera to scan QR codes.",
        "NSMicrophoneUsageDescription": "Minima Core uses your microphone to record a Chat voice note when you choose Voice note."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "minimaCore-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Finance",
      "maintainer": "eurobuddha <eurobuddha@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "minimaCore-${version}-x64.${ext}"
    },
    "files": [
      "main/**",
      "renderer/**",
      "package.json",
      "node_modules/libsodium-wrappers/**",
      "node_modules/libsodium/**",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/sql.js/**",
      "node_modules/@silentbot1/**",
      "node_modules/abort-controller/**",
      "node_modules/chrome-dgram/**",
      "node_modules/cross-fetch-ponyfill/**",
      "node_modules/cross-spawn/**",
      "node_modules/data-uri-to-buffer/**",
      "node_modules/debug/**",
      "node_modules/default-gateway/**",
      "node_modules/event-target-shim/**",
      "node_modules/execa/**",
      "node_modules/fetch-blob/**",
      "node_modules/formdata-polyfill/**",
      "node_modules/get-stream/**",
      "node_modules/human-signals/**",
      "node_modules/inherits/**",
      "node_modules/is-stream/**",
      "node_modules/isexe/**",
      "node_modules/merge-stream/**",
      "node_modules/mimic-fn/**",
      "node_modules/ms/**",
      "node_modules/node-domexception/**",
      "node_modules/node-fetch/**",
      "node_modules/npm-run-path/**",
      "node_modules/onetime/**",
      "node_modules/path-key/**",
      "node_modules/run-series/**",
      "node_modules/sax/**",
      "node_modules/shebang-command/**",
      "node_modules/shebang-regex/**",
      "node_modules/signal-exit/**",
      "node_modules/strip-final-newline/**",
      "node_modules/unordered-array-remove/**",
      "node_modules/web-streams-polyfill/**",
      "node_modules/which/**",
      "node_modules/xml2js/**",
      "node_modules/xmlbuilder/**"
    ],
    "extraResources": [
      {
        "from": "resources/minima.jar",
        "to": "minima.jar"
      },
      {
        "from": "resources/parlons-node.jar",
        "to": "parlons-node.jar"
      },
      {
        "from": "resources/jre",
        "to": "jre"
      },
      {
        "from": "resources/keets-sidecar",
        "to": "keets-sidecar",
        "filter": [
          "**/*",
          "!**/prebuilds/android-*/**",
          "!**/prebuilds/ios-*/**"
        ]
      }
    ]
  },
  "dependencies": {
    "@silentbot1/nat-api": "^0.4.9",
    "libsodium-wrappers": "^0.7.15",
    "qrcode-generator": "^2.0.4",
    "sql.js": "^1.13.0"
  },
  "parlonsNode": "0.2.152",
  "parlonsNodeSha256": "1b3a0dc7921675d54e96a611be5a37194116227c4529e32d8aeb74bb72ec1fd1",
  "flavor": "",
  "flavors": {
    "pandamonium": {
      "productName": "Pandamonium Desktop",
      "appId": "com.eurobuddha.pandamonium.desktop",
      "userData": "PandamoniumDesktop",
      "keychainService": "com.eurobuddha.pandamonium.desktop.rpc",
      "basePort": 17001,
      "updates": false,
      "loginItem": false,
      "windowTitle": "Pandamonium Desktop",
      "artifact": "PandamoniumDesktop",
      "autostartFile": "pandamonium-desktop.desktop",
      "jars": {
        "dir": "resources-pandamonium",
        "parlonsNode": "0.2.153",
        "parlonsNodeSha256": "c2b8cb33b07b78197cc4ed0b5c82cf3f14b6407095f20963971d6b932b25e6af",
        "minima": "1.1.2.31-euro5",
        "minimaSha256": "93111abb83f2239970257e692026b6033f3b1caeaf31db52604b9f531a0617ea"
      }
    }
  }
}
