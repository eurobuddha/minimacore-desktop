{
  "name": "minimacore-desktop",
  "productName": "minimaCore",
  "version": "0.5.3",
  "description": "macOS wrapper for the minimaCore node — runs and updates minima.jar locally, with the native-styled self-custody wallet UI over the node's RPC.",
  "author": "eurobuddha",
  "license": "MIT",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.eurobuddha.minimacore",
    "productName": "minimaCore",
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "minimaMail uses the camera only to scan a contact's QR code."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "files": [
      "main/**",
      "renderer/**",
      "package.json",
      "node_modules/libsodium-wrappers/**",
      "node_modules/libsodium/**",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/sql.js/**",
      "node_modules/@silentbot1/**",
      "node_modules/abort-controller/**",
      "node_modules/chrome-dgram/**",
      "node_modules/cross-fetch-ponyfill/**",
      "node_modules/cross-spawn/**",
      "node_modules/data-uri-to-buffer/**",
      "node_modules/debug/**",
      "node_modules/default-gateway/**",
      "node_modules/event-target-shim/**",
      "node_modules/execa/**",
      "node_modules/fetch-blob/**",
      "node_modules/formdata-polyfill/**",
      "node_modules/get-stream/**",
      "node_modules/human-signals/**",
      "node_modules/inherits/**",
      "node_modules/is-stream/**",
      "node_modules/isexe/**",
      "node_modules/merge-stream/**",
      "node_modules/mimic-fn/**",
      "node_modules/ms/**",
      "node_modules/node-domexception/**",
      "node_modules/node-fetch/**",
      "node_modules/npm-run-path/**",
      "node_modules/onetime/**",
      "node_modules/path-key/**",
      "node_modules/run-series/**",
      "node_modules/sax/**",
      "node_modules/shebang-command/**",
      "node_modules/shebang-regex/**",
      "node_modules/signal-exit/**",
      "node_modules/strip-final-newline/**",
      "node_modules/unordered-array-remove/**",
      "node_modules/web-streams-polyfill/**",
      "node_modules/which/**",
      "node_modules/xml2js/**",
      "node_modules/xmlbuilder/**"
    ],
    "extraResources": [
      {
        "from": "resources/minima.jar",
        "to": "minima.jar"
      },
      {
        "from": "resources/jre",
        "to": "jre"
      }
    ]
  },
  "dependencies": {
    "@silentbot1/nat-api": "^0.4.9",
    "libsodium-wrappers": "^0.7.15",
    "qrcode-generator": "^2.0.4",
    "sql.js": "^1.13.0"
  }
}
