graphify-out/graph.json merge=graphify

# PandaPools engine files are copied byte-for-byte from the pandapools-mds MiniDapp and their sha256 digests
# are pinned in scripts/pandapools-parity.manifest.json. Any line-ending translation would change those bytes
# and fail the parity gate on the Windows/Linux CI legs, so keep them exactly as committed.
main/pandapools/*.js -text
# The same rule for the Dexicon engine (scripts/dexicon-parity.manifest.json).
main/dexicon/lib/*.js -text
main/dexicon/crypto/*.js -text
main/dexicon/vendor/*.js -text
main/dexicon/resting/*.js -text
# The Dexicon page (scripts/dexicon-page.manifest.json): verbatim bytes; mds.js there is this app's own.
renderer/dexicon/index.html -text
renderer/dexicon/ui/* -text
renderer/dexicon/lib/*.js -text
renderer/dexicon/resting/*.js -text
